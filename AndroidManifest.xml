<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.samsung.oneui9.metamusewidget">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <!-- Needed to find the Muse app (and the original's fallback packages) on the device. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Ask page only: Google text predictions while typing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wallpaper read for the glass pill (file lane, older APIs). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">

        <!-- The ask page: type with suggestions, Enter sends the
             text into Muse's composer. Opened by the widget bar. -->
        <activity
            android:name=".ComposeActivity"
            android:exported="false"
            android:label="@string/ask_title"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- Quick Settings tile: opens the ask page from anywhere. -->
        <service
            android:name=".AskTileService"
            android:exported="true"
            android:icon="@drawable/ic_assistant"
            android:label="@string/ask_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- The app itself: the Customize settings screen (live
             preview, bar style, themes, Custom hue/saturation,
             transparency, shortcut), modeled on the Google search
             widget's. The launcher opens it in global scope; it is
             also the widget's configure activity (per-widget scope
             from the add flow and the long-press pencil). -->
        <activity
            android:name=".WidgetCustomizeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Router: fires one catalog URI at Muse, with the fallback chain. -->
        <activity
            android:name=".LaunchMuseActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 4x1 One UI 9 glass search-bar widget (the original, restyled to spec). -->
        <receiver
            android:name=".SearchBarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_search_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_search" />
        </receiver>

    </application>
</manifest>
