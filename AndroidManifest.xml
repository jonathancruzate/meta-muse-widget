<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.jonathancruzate.metamusewidget">

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <!-- Needed to find the Muse app (and the original's fallback packages) on the device. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Ask page only: Google text predictions while typing. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Muse panel only: read the next calendar event for Up next. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Wallpaper read for the glass pill (file lane, older APIs). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Muse Launcher Pack v5.1.0: the leave-by Live Update
         feeder posts one ongoing notification; the grant itself
         is the user's, asked by the system, never assumed. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Muse Launcher Pack v5.2.0 (design D4): the Sleep tile
         reads last night's sleep summary on device only. The
         grant lives in the Health Connect app and stays the
         user's to give or withhold; without it the tile shows
         its designed empty state. -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme">

        <!-- The ask page: type with suggestions, Enter sends the
             text into Muse's composer. Opened by the widget bar. -->
        <activity
            android:name=".ComposeActivity"
            android:exported="false"
            android:label="@string/ask_title"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <!-- The Muse companion panel: greeting, Up next, Ask Muse,
             and Home controls on stock One UI Home. Entry points
             are in-app only (app-icon shortcut routed through
             WidgetCustomizeActivity, and the Muse QS tile), so
             this activity is not exported. -->
        <activity
            android:name=".MusePanelActivity"
            android:exported="false"
            android:label="@string/muse_companion_title"
            android:theme="@style/AppTheme" />

        <!-- The activity picker (v4.9.0): the catalog destinations
             as prompt stems on the ask page (Muse gates its URIs,
             so rows prefill text instead of firing links). In-app
             entry points only: the panel's Ask card and the
             app-icon shortcut routed through WidgetCustomizeActivity. -->
        <activity
            android:name=".PickerActivity"
            android:exported="false"
            android:label="@string/picker_title"
            android:theme="@style/AppTheme" />

        <!-- Quick Settings tile: opens the Muse companion panel from anywhere. -->
        <service
            android:name=".MuseTileService"
            android:exported="true"
            android:icon="@drawable/ic_person"
            android:label="@string/muse_companion_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Quick Settings tile: opens the ask page from anywhere. -->
        <service
            android:name=".AskTileService"
            android:exported="true"
            android:icon="@drawable/ic_assistant"
            android:label="@string/ask_title"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- The app itself: the Customize settings screen (live
             preview, bar style, themes, Custom hue/saturation,
             transparency, shortcut), modeled on the Google search
             widget's. The launcher opens it in global scope; it is
             also the widget's configure activity (per-widget scope
             from the add flow and the long-press pencil). -->
        <activity
            android:name=".WidgetCustomizeActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Router: fires one catalog URI at Muse, with the fallback chain. -->
        <activity
            android:name=".LaunchMuseActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- 4x1 One UI 9 glass search-bar widget (the original, restyled to spec). -->
        <receiver
            android:name=".SearchBarWidgetProvider"
            android:exported="true"
            android:label="@string/widget_search_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_search" />
        </receiver>

        <!-- Resizable Muse panel widget (v4.8.0): the live panel
             on the home screen, size-adaptive up to full screen.
             The second intent-filter action is the widget's own
             Refresh affordance (a broadcast back to the provider). -->
        <receiver
            android:name=".MusePanelWidgetProvider"
            android:exported="true"
            android:label="@string/widget_panel_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jonathancruzate.metamusewidget.action.PANEL_WIDGET_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_panel" />
        </receiver>

        <!-- Shortcut panel widget (v4.10.0): up to eight activity
             shortcuts in a 4x2 focus block. Cells are a global
             setting edited on the Customize screen, which is also
             the widget's configure activity. -->
        <receiver
            android:name=".ShortcutPanelWidgetProvider"
            android:exported="true"
            android:label="@string/widget_shortcuts_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_shortcuts" />
        </receiver>


        <!-- Muse Launcher Pack (v5.0.0): search, grid, house,
             setup wizard, tile configure, voice trampoline. -->
        <activity
            android:name=".MuseSearchActivity"
            android:exported="false"
            android:label="@string/pack_search_title"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".MuseGridActivity"
            android:exported="false"
            android:label="@string/pack_grid_title"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".HouseActivity"
            android:exported="false"
            android:label="@string/pack_kind_pick_house"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".SetupWizardActivity"
            android:exported="false"
            android:label="@string/pack_wizard_title"
            android:theme="@style/AppTheme" />

        <activity
            android:name=".TileConfigureActivity"
            android:exported="true"
            android:label="@string/pack_tile_name"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PackVoiceActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!-- Muse Omnibar widget (Pack v5.0.0). -->
        <receiver
            android:name=".MuseOmnibarWidgetProvider"
            android:exported="true"
            android:label="@string/pack_omnibar_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jonathancruzate.metamusewidget.action.PACK_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_omnibar" />
        </receiver>

        <!-- Muse tile framework (Pack v5.0.0). -->
        <receiver
            android:name=".MuseTileWidgetProvider"
            android:exported="true"
            android:label="@string/pack_tile_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jonathancruzate.metamusewidget.action.PACK_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_tile" />
        </receiver>

        <!-- Muse Context Stack cards (Pack v5.0.0). -->
        <receiver
            android:name=".MuseStackWidgetProvider"
            android:exported="true"
            android:label="@string/pack_stack_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jonathancruzate.metamusewidget.action.PACK_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_stack" />
        </receiver>

        <!-- Muse Grid widget (Pack v5.0.0). -->
        <receiver
            android:name=".MuseGridWidgetProvider"
            android:exported="true"
            android:label="@string/pack_grid_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jonathancruzate.metamusewidget.action.PACK_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_grid" />
        </receiver>

        <!-- House Control widget (Pack v5.1.0). -->
        <receiver
            android:name=".MuseHouseWidgetProvider"
            android:exported="true"
            android:label="@string/pack_house_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.jonathancruzate.metamusewidget.action.PACK_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_house" />
        </receiver>

        <!-- Pack action commands (voice, DND, media): own-app
             PendingIntents only. -->
        <receiver
            android:name=".PackActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.jonathancruzate.metamusewidget.action.PACK_VOICE" />
                <action android:name="com.jonathancruzate.metamusewidget.action.PACK_DND_TOGGLE" />
                <action android:name="com.jonathancruzate.metamusewidget.action.PACK_MEDIA_TOGGLE" />
            </intent-filter>
        </receiver>

        <!-- Device Assistance context pokes (design 7.3). -->
        <receiver
            android:name=".ContextReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.jonathancruzate.metamusedeviceassistance.action.CONTEXT_MODE" />
                <action android:name="com.jonathancruzate.metamusedeviceassistance.action.CONTEXT_MEDIA" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
