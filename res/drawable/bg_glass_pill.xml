<?xml version="1.0" encoding="utf-8"?>
<!-- One UI 9 glass floating layer (standard section 9): full pill for search/Now bars,
     glass fill + 1px border. RemoteViews cannot blur, so the glass tint is baked in. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="28dp" />
    <solid android:color="@color/glass_fill" />
    <stroke android:width="1dp" android:color="@color/glass_border" />
</shape>
