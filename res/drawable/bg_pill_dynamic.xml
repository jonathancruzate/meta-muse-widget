<?xml version="1.0" encoding="utf-8"?>
<!-- System-palette variant of the glass pill: Material You / Samsung
     color palette tones (framework system colors, API 31+; the values
     adapt to light/dark and to the device wallpaper palette). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="28dp" />
    <solid android:color="@android:color/system_accent1_100" />
    <stroke
        android:width="1dp"
        android:color="@android:color/system_accent1_300" />
</shape>
