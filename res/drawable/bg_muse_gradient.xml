<?xml version="1.0" encoding="utf-8"?>
<!-- The signature Muse gradient (VDS AuraBrushes plan-selected
     border): MAGENTA_550 to BLUE_600, decomposed 2026-11-13.
     For accent bars and the wizard header. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/muse_gradient_start"
        android:endColor="@color/muse_gradient_end"
        android:type="linear" />
    <corners android:radius="20dp" />
</shape>
