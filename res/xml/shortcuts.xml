<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press app-icon shortcuts. They target the settings
     activity with a widget://shortcut/* data URI; it routes and
     finishes before its UI draws. (There is no Customize
     shortcut: opening the app IS the settings page.) Muse ships
     no app shortcuts of its own (checked against its manifest)
     — no duplication. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="ask"
        android:enabled="true"
        android:icon="@drawable/ic_assistant"
        android:shortcutShortLabel="@string/ask_title">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.samsung.oneui9.metamusewidget"
            android:targetClass="com.samsung.oneui9.metamusewidget.WidgetCustomizeActivity"
            android:data="widget://shortcut/ask" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="muse"
        android:enabled="true"
        android:icon="@drawable/ic_event"
        android:shortcutShortLabel="@string/muse_companion_short_label">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.samsung.oneui9.metamusewidget"
            android:targetClass="com.samsung.oneui9.metamusewidget.WidgetCustomizeActivity"
            android:data="widget://shortcut/muse" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="new"
        android:enabled="true"
        android:icon="@drawable/ic_plus"
        android:shortcutShortLabel="@string/sc_new">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.samsung.oneui9.metamusewidget"
            android:targetClass="com.samsung.oneui9.metamusewidget.WidgetCustomizeActivity"
            android:data="widget://shortcut/new" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
