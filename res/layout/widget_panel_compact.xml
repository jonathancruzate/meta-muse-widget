<?xml version="1.0" encoding="utf-8"?>
<!-- Muse panel widget, COMPACT density (v4.8.0): headline + house
     line only. RemoteViews-supported view classes ONLY — no plain
     View, ever (the 4.3.2->4.5.2 render break; build.sh's render
     guard enforces this for every widget layout). Background is
     the One UI 9 focus-block card; on API 31+ the drawable-v31
     variant swaps the fill for the Material You system neutral
     tone, like a Material You widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_panel_widget"
    android:contentDescription="@string/widget_panel_name"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/foreground"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_house"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/secondary"
        android:textSize="13sp" />
</LinearLayout>
