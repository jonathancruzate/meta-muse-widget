<?xml version="1.0" encoding="utf-8"?>
<!-- The shortcut panel widget (v4.10.0): a One UI focus block
     (bg_card, 18dp) with up to eight medium-card cells (bg_cell,
     14dp) in two rows of four. Cells the user hasn't filled are
     GONE at render time. ONLY RemoteViews-supported classes live
     here (LinearLayout / ImageView / TextView) — a plain View in
     a widget layout is what broke rendering in v4.3.2. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cell_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/cell_icon_0"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_label_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/cell_icon_1"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_label_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/cell_icon_2"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_label_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/cell_icon_3"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_label_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cell_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/cell_icon_4"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_label_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/cell_icon_5"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_label_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell_6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/cell_icon_6"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_label_6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cell_7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cell"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/cell_icon_7"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/cell_label_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
